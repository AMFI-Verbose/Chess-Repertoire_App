# Copy to `.env`. PostgreSQL (local Homebrew install, Neon, Supabase, RDS…):
DATABASE_URL="postgresql://postgres@localhost:5432/chess_repertoire?schema=public"

# Public origin, used in confirmation links:
APP_URL="http://localhost:3000"

# Transactional email. Leave both blank locally: sign-up then prints the
# confirmation link instead of sending it, so no mail server is needed to test.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Chess Repertoire <noreply@yourdomain.com>"
# SMTP_HOST="smtp.yourdomain.com"
# SMTP_PORT="587"
# SMTP_USER="..."
# SMTP_PASS="..."
