// Prisma schema — the single source of truth for your database.
// Every time you change this file you run `npx prisma migrate dev`,
// which diffs it against the real database and generates a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One opening repertoire, e.g. "White: Italian Game" or "Black: Najdorf".
model Repertoire {
  id          String   @id @default(cuid())
  name        String
  side        String // "white" | "black" — which colour you play these lines as
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes Node[]

  @@index([createdAt])
}

/// One node = one position in the move tree.
/// The node stores the move that *leads to* it (san/uci) plus the resulting FEN,
/// so walking up via `parent` reconstructs the whole line.
/// The root node exists exactly once per repertoire: ply 0, no move, starting FEN.
model Node {
  id           String     @id @default(cuid())
  repertoireId String
  repertoire   Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Node?   @relation("MoveTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Node[]  @relation("MoveTree")

  san     String // "Nf3"
  uci     String // "g1f3" — machine-stable id for the move
  fen     String // position AFTER the move
  /// "Board turn castling en-passant" only — the halfmove clock and move number
  /// are dropped, so the SAME position reached by a different move order
  /// produces the SAME key. That is what makes transpositions detectable.
  normFen String  @default("")
  ply     Int // half-move number: root = 0, 1.e4 = 1, ...e5 = 2
  comment String? // your own note on this position
  isMain  Boolean @default(false) // the "main line" child is highlighted in the tree

  review Review?

  createdAt DateTime @default(now())

  // Two sibling moves can never be the same move.
  @@unique([parentId, uci])
  @@index([repertoireId])
  @@index([parentId])
  @@index([normFen])
}

/// Reference data: recognised opening names, sourced from the free
/// lichess-org/chess-openings dataset (CC0). This is the *whole* ECO table
/// (~3,900 lines), not a hand-picked subset.
///
/// Detection is an exact lookup on `epd` — the normalized position key of the
/// line's final position — which is how Lichess itself names a position.
model Opening {
  id       String @id @default(cuid())
  eco      String // "B90"
  name     String // "Sicilian Defense: Najdorf Variation"
  movesUci String // "e2e4 c7c5 g1f3 d7d6 d2d4 cxd4 f3d4 g8f6 b1c3 a7a6"
  epd      String @default("") // normalized FEN of the final position
  ply      Int // how many half-moves this entry covers

  @@index([epd])
  @@index([ply])
}

/// Spaced-repetition card attached to a position (Milestone 3).
/// SM-2 style scheduling: interval grows when you get it right, resets when you don't.
/// Daily / practice tactics.
/// `solution` is a space-separated UCI sequence that starts with the solver's
/// move and alternates sides — exactly the shape Lichess's daily puzzle API
/// returns, so imported and seeded puzzles behave identically.
model Puzzle {
  id        String          @id
  fen       String // position the solver starts from
  solution  String // "d1b8 b8d7 d8d7"
  rating    Int             @default(1200)
  themes    String          @default("")
  title     String          @default("")
  source    String          @default("seed") // "seed" | "lichess-daily"
  day       String?         @unique // "2026-11-19" for that day's puzzle
  createdAt DateTime        @default(now())
  attempts  PuzzleAttempt[]

  // Selection is always "puzzles near my rating", so the band must be indexed.
  @@index([rating])
}

model PuzzleAttempt {
  id           String   @id @default(cuid())
  puzzleId     String
  solved       Boolean
  // Elo snapshot, so history can be replayed and a rating graph drawn later.
  ratingBefore Int?
  ratingAfter  Int?
  createdAt    DateTime @default(now())
  puzzle       Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// One finished game against the engine. The PGN is the record; everything
/// else is denormalised so the history list never has to replay it.
model Game {
  id          String   @id @default(cuid())
  kind        String   @default("engine") // "engine" for now
  playerColor String // "white" | "black" — the side you had
  result      String // "win" | "loss" | "draw", from your point of view
  resultText  String   @default("") // "You won by checkmate"
  skill       Int      @default(12) // engine Skill Level, i.e. opponent strength
  level       Int      @default(4) // the named level you picked (1–8)
  botId       String? // which character you played, when it was one
  timeControl String   @default("unlimited") // "5+3", or "unlimited"
  startFen    String   @default("") // non-standard start position, else empty
  pgn         String
  fen         String // final position, so the board can be restored without replay
  plies       Int      @default(0)
  /// JSON written by the review pass: accuracy + centipawn loss per colour.
  analysis    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// One local player. There is no auth — this row *is* the current user.
model Profile {
  id           String   @id @default("local")
  name         String   @default("You")
  puzzleRating Int      @default(1500)
  peakRating   Int      @default(1500)
  updatedAt    DateTime @updatedAt
}

/// A curated game or line that ships with the app — the "community" library.
/// Read-only content plus a comment thread; no accounts, no server.
model Study {
  id        String    @id @default(cuid())
  title     String
  subtitle  String    @default("")
  pgn       String
  eco       String    @default("")
  /// Who published it: "Community" (seeded), "Lichess" (imported), or a handle.
  author    String    @default("Community")
  /// "local" (a game you published), "seed", or "lichess".
  source    String    @default("local")
  sourceUrl String    @default("")
  /// Lichess game id, so the daily import never inserts the same game twice.
  externalId String?  @unique
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  studyId   String
  author    String
  body      String
  /// Half-move this note is attached to. 0 = about the game, not a position.
  ply       Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

/// Spaced repetition card, one per node. Unused until the trainer ships.
model Review {
  id     String @id @default(cuid())
  nodeId String @unique
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  attempts   Int       @default(0)
  correct    Int       @default(0)
  interval   Int       @default(1) // days until next review
  ease       Float     @default(2.5) // multiplier applied on each success
  dueAt      DateTime  @default(now())
  lastSeenAt DateTime?

  // Every session asks "what is due", so the scheduler column is indexed.
  @@index([dueAt])
}

/// A real account. The community is readable without one, but publishing a
/// study and writing a note both require signing in.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Lowercase, unique, shown next to every study and note this user writes.
  handle       String    @unique
  passwordHash String
  /// Set by clicking the link in the verification email. Unverified accounts
  /// can read everything but cannot publish or write notes.
  emailVerified Boolean  @default(false)
  createdAt    DateTime  @default(now())
  studies      Study[]
  comments     Comment[]
  sessions     Session[]
  emailTokens  EmailToken[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One live verification link. Deleting the row is what "used" means.
model EmailToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Fixed-window counters for signup / sign-in / posting limits. Kept in the
/// database so several app instances share one budget (Vercel, Docker replicas).
model RateLimit {
  id          String   @id
  bucket      String
  count       Int      @default(0)
  windowStart DateTime

  @@index([windowStart])
}
