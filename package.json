{
  "name": "chess-repertoire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-engine.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "prisma migrate deploy && node scripts/seed.mjs && node scripts/seed-openings-lichess.mjs && node scripts/seed-community.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:openings": "node scripts/seed-openings-lichess.mjs",
    "db:backfill": "node scripts/backfill-normfen.mjs",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed && npm run db:openings && npm run db:content",
    "db:content": "node scripts/seed-community.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "chess.js": "^1.4.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.1.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
